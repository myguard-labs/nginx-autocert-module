*.o
*.so
*.lo
*.la
.libs/
tmp/
objs/
.codex-*.txt

# local build/test scratch
.build/

# agent worktrees / local tooling
.claude/

# crash dumps (local valgrind / ASAN runs)
core
core.*
vgcore.*

# gcc/clang dump files from -fdump-* runs; these land NEXT TO THE SOURCE as
# src/<file>.c.<pid>.dump and are large (tens of MB), so an unguarded
# `git add -A` after a local analysis run sweeps them into the commit.
*.dump

# coverage artifacts
*.gcda
*.gcno
*.gcov
coverage.info*

# local ci-build.sh fetches (any profile, including coverage)
/nginx-*.tar.gz
/nginx-[0-9]*/
