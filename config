ngx_addon_name=ngx_http_autocert_module

# This module is an ACME client: it opens its own TLS connections to the CA
# (ngx_ssl_create_connection / ngx_ssl_handshake / SSL_CTX_set_verify in
# src/ngx_autocert_acme.c) and serves per-SNI certificates. All of that lives
# behind nginx's NGX_HTTP_SSL guard, so without SSL support the build dies deep
# in the compiler with "implicit declaration of function 'SSL_CTX_set_verify'"
# and "invalid use of incomplete typedef 'ngx_ssl_connection_t'". Fail here
# instead, with a message that names the flag.
#
# $HTTP_SSL is tested rather than the literal flag because --with-http_v3_module
# implies it too (auto/modules); either is a valid way to satisfy this module.
if [ "${HTTP_SSL:-NO}" != YES ]; then
    echo
    echo "$0: error: $ngx_addon_name requires nginx HTTP SSL support."
    echo "Reconfigure with either:"
    echo "  --with-http_ssl_module"
    echo "  --with-http_v3_module   (turns SSL support on implicitly)"
    echo
    exit 1
fi

# Test-only seed directives (autocert_test_challenge / autocert_test_alpn) are
# compiled in ONLY when AUTOCERT_TEST=1 is exported at configure time (CI e2e
# that needs to seed a challenge before the order flow runs). Production builds
# omit them entirely, so a stray/templated directive cannot inject a forged key
# authorization the :80 handler would serve.
if [ "${AUTOCERT_TEST:-}" = "1" ]; then
    CFLAGS="$CFLAGS -DNGX_AUTOCERT_TEST=1"
fi

# One module ships from this addon:
#   - ngx_http_autocert_module : HTTP module; directives, config model, crypto,
#                                per-SNI cert serving, AND the ACME engine driver
#                                (ngx_autocert_driver.c) which runs on worker 0
#                                via the module's init_process hook.
#
# The dedicated privileged helper process (the old CORE ngx_autocert_process
# module) is gone: the ACME state machine is process-agnostic and now runs on
# worker 0, matching angie's native acme and the official Rust nginx-acme.
#
# Built as a dynamic module (load_module). The else branch is the legacy
# static-link path for pre-1.9.11 nginx that lacks $ngx_module_link / auto/module.

AUTOCERT_SRCS="$ngx_addon_dir/src/ngx_http_autocert_module.c \
               $ngx_addon_dir/src/ngx_autocert_driver.c \
               $ngx_addon_dir/src/ngx_autocert_acme.c \
               $ngx_addon_dir/src/ngx_autocert_json.c \
               $ngx_addon_dir/src/ngx_autocert_account.c \
               $ngx_addon_dir/src/ngx_autocert_order.c \
               $ngx_addon_dir/src/ngx_autocert_challenge.c \
               $ngx_addon_dir/src/ngx_autocert_alpn.c \
               $ngx_addon_dir/src/ngx_autocert_serve.c \
               $ngx_addon_dir/src/ngx_autocert_requests.c \
               $ngx_addon_dir/src/ngx_http_autocert_crypto.c \
               $ngx_addon_dir/src/ngx_autocert_conf.c"

AUTOCERT_DEPS="$ngx_addon_dir/src/ngx_autocert_driver.h \
               $ngx_addon_dir/src/ngx_autocert_acme.h \
               $ngx_addon_dir/src/ngx_autocert_json.h \
               $ngx_addon_dir/src/ngx_autocert_account.h \
               $ngx_addon_dir/src/ngx_autocert_order.h \
               $ngx_addon_dir/src/ngx_autocert_challenge.h \
               $ngx_addon_dir/src/ngx_autocert_alpn.h \
               $ngx_addon_dir/src/ngx_autocert_serve.h \
               $ngx_addon_dir/src/ngx_autocert_requests.h \
               $ngx_addon_dir/src/ngx_http_autocert_crypto.h \
               $ngx_addon_dir/src/ngx_autocert_shared.h \
               $ngx_addon_dir/src/ngx_autocert_win32.h \
               $ngx_addon_dir/src/ngx_http_autocert_conf.h"

# Link libraries differ per platform, and the difference is not just spelling.
#
# On win32 there are no -l flags: MSVC's linker takes .lib filenames directly.
# Two system libraries come with them that POSIX gets for free from libc:
#   ws2_32.lib   - sockets. The ACME client opens its own connections to the CA
#                  (ngx_autocert_acme.c), so this module pulls in the winsock
#                  symbols itself rather than riding on nginx core's link line.
#   advapi32.lib - the Win32 security API (SetNamedSecurityInfo and friends),
#                  needed for the key-file ACL that replaces fchmod(0600).
#
# crypt32.lib joins them whenever OpenSSL is linked statically: libcrypto calls
# CertOpenStore/CertFindCertificateInStore for the Windows certificate store,
# and a static link has nothing else to resolve those from. A DLL build hides
# the dependency inside libcrypto-3-x64.dll, so this only bites the static
# configuration the CI gate uses.
#
# None of these names are fixed, and the split is by COMPILER rather than by
# platform: MSVC takes .lib filenames on the command line, while MinGW-w64
# drives a GNU ld that wants the -l form. Keying off NGX_PLATFORM alone would
# hand MinGW the MSVC spelling and fail at link, which is why both CI cells
# exist. NGX_CC_NAME is set by auto/cc/name before a module's config runs.
# NGX_AUTOCERT_WIN32_SSL_LIBS still overrides the SSL half for a builder whose
# OpenSSL is named neither way.
#
# The default for AUTOCERT_SSL_LIBS is EMPTY, not a bare -lssl/libssl.lib. A
# win32 build configured with --with-openssl=<srcdir> already has nginx core
# (auto/lib/openssl/conf) append the built OpenSSL archives to CORE_LIBS BY
# ABSOLUTE PATH, so a module-added bare SSL flag with no -L/-LIBPATH pointing
# at that build is redundant on every win32 configuration nginx itself
# supports, and FATAL (ld/link cannot resolve the name) on any configuration
# where no import library of that name is on the default search path — which
# is exactly what happened on the MinGW CI cell (W22). A builder who links
# OpenSSL some other way (prebuilt/system OpenSSL not passed via
# --with-openssl) can still opt back in via NGX_AUTOCERT_WIN32_SSL_LIBS.
if [ "${NGX_PLATFORM:-}" = win32 ]; then
    # The same clang|gcc split nginx core uses for its own win32 libraries
    # (auto/os/win32:20-31), for the same reason: both halves of the line are
    # spelled differently per toolchain, not just the OpenSSL half.
    case "${NGX_CC_NAME:-}" in
        clang | gcc)
            AUTOCERT_SSL_LIBS="${NGX_AUTOCERT_WIN32_SSL_LIBS:-}"
            AUTOCERT_SYS_LIBS="-lws2_32 -ladvapi32 -lcrypt32"
            ;;
        *)
            AUTOCERT_SSL_LIBS="${NGX_AUTOCERT_WIN32_SSL_LIBS:-}"
            AUTOCERT_SYS_LIBS="ws2_32.lib advapi32.lib crypt32.lib"
            ;;
    esac
    AUTOCERT_LIBS="$AUTOCERT_SSL_LIBS $AUTOCERT_SYS_LIBS"
else
    # POSIX is untouched by the win32 fix above: here the module builds as a
    # dynamic .so (auto/module's DYNAMIC path) that is NOT linked against
    # nginx core's static OpenSSL archives, so -lssl -lcrypto are the module's
    # own real, load-bearing dependency, resolved normally via the system
    # linker's default -L search path (no absolute-path duplication problem
    # exists on this arm).
    AUTOCERT_LIBS="-lssl -lcrypto"
fi

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_autocert_module
    ngx_module_srcs="$AUTOCERT_SRCS"
    ngx_module_libs="$AUTOCERT_LIBS"
    ngx_module_deps="$AUTOCERT_DEPS"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_autocert_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $AUTOCERT_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $AUTOCERT_DEPS"
    CORE_LIBS="$CORE_LIBS $AUTOCERT_LIBS"
fi
