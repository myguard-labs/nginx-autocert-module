# libFuzzer dictionary for the autocert parsers (fuzz_json + fuzz_http).
# Whitespace MUST be hex-escaped (\x09/\x0a/\x0d/\x20) — libFuzzer's
# ParseDictionaryFile rejects literal \t/\n.

# --- JSON structural punctuation ---
"{"
"}"
"["
"]"
":"
","
"\""
"\\"
"true"
"false"
"null"
"\\u0000"
"\\ud800"
"\\udc00"
"\\n"
"\\t"
"e+"
"e-"
"0"
"-0"

# --- ACME directory / order / account JSON keys ---
"newNonce"
"newAccount"
"newOrder"
"newAuthz"
"revokeCert"
"keyChange"
"identifier"
"identifiers"
"authorizations"
"challenges"
"finalize"
"certificate"
"status"
"token"
"type"
"url"
"value"
"detail"
"contact"
"termsOfService"
"http-01"
"dns-01"
"pending"
"valid"
"invalid"
"ready"
"processing"

# --- HTTP response framing tokens ---
"HTTP/1."
"HTTP/1.0\x20"
"HTTP/1.1\x20"
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
"200\x20"
"201\x20"
"404\x20"
"Content-Length:"
"Content-Length:\x20"
"Transfer-Encoding:"
"Transfer-Encoding:\x20"
"chunked"
"Location:\x20"
"Replay-Nonce:\x20"
"Content-Type:\x20"
"application/json"
"https://"
